# Скопировать в .env.cloud. Файл .env.cloud исключён из Git.
# Публичные настройки Web App тестового Firebase-проекта, не service account.
CLOUD_FIREBASE_PROJECT_ID=
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_DATABASE_URL=
WXT_FIREBASE_INVITATION_BASE_URL=
WXT_BACKEND_GENERATION=qa-v1
WXT_CONTROL_PROJECT_ID=

# Обязательные условия облачного замера; записываются в отчёт.
CLOUD_FIREBASE_REGION=
CLOUD_CLIENT_LOCATION=
CLOUD_NETWORK=
# Необязательный контакт на QA Hosting.
RELEASE_SUPPORT_EMAIL=
