{
  "name": "watch-youtube-with-friends",
  "version": "0.3.0",
  "private": true,
  "description": "Chrome extension for watching YouTube together",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briginas/watch-youtube-with-friends.git"
  },
  "homepage": "https://github.com/briginas/watch-youtube-with-friends#readme",
  "bugs": {
    "url": "https://github.com/briginas/watch-youtube-with-friends/issues"
  },
  "scripts": {
    "spec:validate": "openspec validate --all --strict --no-interactive",
    "dev": "wxt",
    "build": "wxt build -b chrome --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build:player-probe": "WXT_PLAYER_PROBE=1 wxt build -b chrome --mv3",
    "test:player": "npm run build:player-probe && playwright test --config playwright.player.config.ts",
    "test:player:youtube": "npm run build:player-probe && YOUTUBE_PLAYER_REAL=1 playwright test --config playwright.player.config.ts",
    "build:firebase-probe": "WXT_FIREBASE_PROBE=1 wxt build -b chrome --mv3",
    "test:firebase-context": "npm run build:firebase-probe && node scripts/firebase.mjs emulators:exec --only auth,database,hosting --project demo-watch-together \"playwright test --config playwright.firebase.config.ts\"",
    "build:transport": "WXT_FIREBASE_EMULATORS=1 wxt build -b chrome --mv3",
    "build:cloud": "node scripts/cloud.mjs build",
    "deploy:rules": "node scripts/cloud.mjs deploy-rules",
    "deploy:cloud": "node scripts/cloud.mjs deploy",
    "test:cloud": "node scripts/cloud.mjs measure",
    "probe:youtube-delivery": "node scripts/youtube-delivery.mjs",
    "test:transport": "npm run build:transport && node scripts/firebase.mjs emulators:exec --only auth,database,hosting --project demo-watch-together \"playwright test --config playwright.transport.config.ts\"",
    "postinstall": "wxt prepare",
    "emulators": "node scripts/firebase.mjs emulators:start --only auth,database,hosting --project demo-watch-together",
    "test:integration": "node scripts/firebase.mjs emulators:exec --only auth,database,hosting --project demo-watch-together \"vitest run --config vitest.integration.config.ts\"",
    "icons:build": "node scripts/icons.mjs",
    "release:build": "node scripts/release.mjs build",
    "release:audit": "node scripts/release.mjs audit",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:prepare-backend": "node scripts/release.mjs prepare-backend",
    "release:prepare-control": "node scripts/release.mjs prepare-control",
    "release:deploy-backend": "node scripts/release.mjs deploy-backend",
    "release:deploy-control": "node scripts/release.mjs deploy-control",
    "status:prepare": "node scripts/service-status.mjs prepare",
    "status:deploy": "node scripts/release.mjs deploy-control",
    "config:init": "node scripts/config-init.mjs",
    "repo:audit": "node scripts/audit-repository.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.16.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "firebase-tools": "15.34.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^24.12.0"
  },
  "type": "module"
}
