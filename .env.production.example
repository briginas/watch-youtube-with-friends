# Только публичные настройки отдельного production Firebase Web App.
# Скопируйте в .env.production (исключён из Git). Service account здесь не нужен.
RELEASE_FIREBASE_PROJECT_ID=
RELEASE_STORE_ID=
RELEASE_STORE_PUBLISHED=0
RELEASE_SUPPORT_EMAIL=
WXT_FIREBASE_API_KEY=
WXT_FIREBASE_PROJECT_ID=
WXT_FIREBASE_DATABASE_URL=
WXT_FIREBASE_INVITATION_BASE_URL=
WXT_BACKEND_GENERATION=
WXT_CONTROL_PROJECT_ID=
# Для нового production control должен отличаться от backend. Реальные IDs задаются при rollout.
